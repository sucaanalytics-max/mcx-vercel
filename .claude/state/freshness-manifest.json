{
  "version": 1,
  "description": "MCX dashboard data-freshness rules. One entry per data domain backing the 10 tabs. 'grace_days' = trading days a domain may legitimately lag the expected latest trading day before it counts as STALE. The freshness-scanner reads this; the /freshness-check orchestrator dispatches 'fixer' agents for STALE domains in dependency order.",
  "expected_day_rule": "latest_completed_trading_day",
  "session_complete_after_ist": "23:30",
  "domains": [
    {"domain": "revenue", "tabs": ["Daily Predictions", "Timeline Dashboard", "Interactive Forecast"],
     "table": "mcx_daily_revenue", "date_col": "trading_date", "grace_days": 0,
     "fixer": "revenue-updater"},
    {"domain": "share_price", "tabs": ["Fair Value inputs", "Commodities (mcx_stock)"],
     "table": "mcx_share_price", "date_col": "trading_date", "grace_days": 1,
     "fixer": "price-updater", "calendar": "NSE"},
    {"domain": "valuation", "tabs": ["Fair Value"],
     "table": "mcx_valuation", "date_col": "trading_date", "grace_days": 1,
     "fixer": "signals-updater", "cron_fn": "lib.cron_valuation:run_refresh", "depends_on": ["revenue", "share_price"]},
    {"domain": "models", "tabs": ["Analytics"],
     "table": "mcx_model_signals", "date_col": "trading_date", "grace_days": 1,
     "fixer": "signals-updater", "cron_fn": "lib.cron_models:compute_signals", "depends_on": ["valuation"]},
    {"domain": "momentum", "tabs": ["Momentum"],
     "table": "mcx_momentum_signals", "date_col": "trading_date", "grace_days": 1,
     "fixer": "signals-updater", "cron_fn": "lib.cron_momentum:compute_momentum", "depends_on": ["revenue"]},
    {"domain": "commodity", "tabs": ["Commodities"],
     "table": "mcx_commodity_daily", "date_col": "trading_date", "grace_days": 1,
     "fixer": "commodity-updater"},
    {"domain": "commodity_signals", "tabs": ["Commodities"],
     "table": "mcx_commodity_signals", "date_col": "trading_date", "grace_days": 1,
     "fixer": "commodity-updater", "cron_fn": "lib.cron_commodity_signals:compute_commodity_signals", "depends_on": ["commodity"]},
    {"domain": "commodity_prices", "tabs": ["Commodities (price panel)"],
     "table": "mcx_commodity_prices", "date_col": "price_date", "grace_days": 2,
     "fixer": "commodity-updater",
     "note": "keyless yfinance via scripts/commodity_price_refresh.py; needs the one-time anon-write grant in scripts/sql/enable_commodity_prices_writes.sql"},
    {"domain": "margins", "tabs": ["Margins"],
     "table": "mcx_margin_daily", "date_col": "snapshot_date", "grace_days": 2,
     "fixer": "margins-updater",
     "note": "SPAN margins update sporadically; Sharekhan feed + MCXCCL scraper are both currently degraded. grace_days is wider to avoid daily false alarms."},
    {"domain": "oi", "tabs": ["OI Participants"],
     "table": "mcx_oi_participants", "date_col": "report_date", "grace_days": 1,
     "fixer": "oi-updater"},
    {"domain": "quarterly", "tabs": ["Quarterly P&L"],
     "source": "code:api/quarterly.py:QUARTERLY_ACTUALS", "cadence": "quarterly",
     "report_lag_days": 45, "fixer": "quarterly-updater",
     "note": "Not DB-backed. The scanner flags it when the most recently reportable fiscal quarter is absent from QUARTERLY_ACTUALS."}
  ],
  "escalation": {"max_fix_attempts": 2, "on_repeated_failure": "investigator"},
  "alert": {"macos_notification_on": ["DEGRADED", "FAILED"], "fix_streak_alert": 3, "email_on": null,
            "email_to": "jay.bansal@tuskinvest.com"}
}

<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.mcx.freshness-alert</string>
    <!-- Read-only freshness scan + a macOS notification when anything is not
         OK (scripts/freshness_alert.py). No Claude, no writes. The scan needs
         only the standard library; mcx_python.sh keeps the interpreter choice
         the same as the other jobs. -->
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>-c</string>
        <string>exec "$(./scripts/mcx_python.sh)" scripts/freshness_alert.py</string>
    </array>
    <key>WorkingDirectory</key>
    <string>/Users/pranayagarwal/Dropbox/My Mac (Pranay's MacBook Air)/Documents/MCX/mcx-vercel</string>
    <!-- Mon–Sat 09:00 IST: after the 07:00 daily_verify, the overnight Vercel
         crons and the relay's 08:55 start. Saturday covers Friday's session. -->
    <key>StartCalendarInterval</key>
    <array>
        <dict><key>Weekday</key><integer>1</integer><key>Hour</key><integer>9</integer><key>Minute</key><integer>0</integer></dict>
        <dict><key>Weekday</key><integer>2</integer><key>Hour</key><integer>9</integer><key>Minute</key><integer>0</integer></dict>
        <dict><key>Weekday</key><integer>3</integer><key>Hour</key><integer>9</integer><key>Minute</key><integer>0</integer></dict>
        <dict><key>Weekday</key><integer>4</integer><key>Hour</key><integer>9</integer><key>Minute</key><integer>0</integer></dict>
        <dict><key>Weekday</key><integer>5</integer><key>Hour</key><integer>9</integer><key>Minute</key><integer>0</integer></dict>
        <dict><key>Weekday</key><integer>6</integer><key>Hour</key><integer>9</integer><key>Minute</key><integer>0</integer></dict>
    </array>
    <key>StandardOutPath</key>
    <string>/Users/pranayagarwal/Library/Logs/mcx/freshness_alert.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/pranayagarwal/Library/Logs/mcx/freshness_alert.log</string>
    <key>RunAtLoad</key>
    <false/>
    <key>ProcessType</key>
    <string>Background</string>
</dict>
</plist>

<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.mcx.backtest</string>
    <key>ProgramArguments</key>
    <array>
        <!-- scripts/mcx_python.sh picks the first interpreter that has the
             packages (MCX_PYTHON, .venv, python3.14, python3), so a Homebrew
             upgrade can't silently strand the job the way 10 Nov did. -->
        <string>/bin/bash</string>
        <string>-c</string>
        <string>exec "$(./scripts/mcx_python.sh)" scripts/backtest_projection.py --days 30</string>
    </array>
    <key>WorkingDirectory</key>
    <string>/Users/pranayagarwal/Dropbox/My Mac (Pranay's MacBook Air)/Documents/MCX/mcx-vercel</string>
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>7</integer>
        <key>Minute</key>
        <integer>30</integer>
    </dict>
    <key>StandardOutPath</key>
    <string>/Users/pranayagarwal/Library/Logs/mcx/backtest.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/pranayagarwal/Library/Logs/mcx/backtest.log</string>
    <key>RunAtLoad</key>
    <false/>
</dict>
</plist>
